{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env*", "**/.env*"],
  "globalEnv": ["CI", "NODE_ENV", "PORT"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"],
      "env": ["NEXT_PUBLIC_*", "VITE_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["NEXT_PUBLIC_*", "VITE_*", "HOST", "CORS_ORIGINS", "TRUST_PROXY", "BODY_LIMIT_BYTES"]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "env": ["PORT", "HOST", "CORS_ORIGINS", "TRUST_PROXY", "BODY_LIMIT_BYTES"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$", "!**/.next/**", "!**/dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "!**/.next/**", "!**/dist/**"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "clean": {
      "cache": false
    },
    "format": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "!**/node_modules/**", "!**/.next/**", "!**/dist/**"]
    }
  }
}
